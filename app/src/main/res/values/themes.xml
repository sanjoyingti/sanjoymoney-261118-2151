=== ABOUT: The dark window theme so the app and the floating panel start dark with no title bar ===
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sanjoy" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sanjoy_bg</item>
        <item name="android:statusBarColor">@color/sanjoy_bg</item>
        <item name="android:navigationBarColor">@color/sanjoy_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
